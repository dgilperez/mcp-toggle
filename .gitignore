# Sensitive Configuration Files
.env
.env.local
.env.*.local
*config.json
*-config.json

# But allow example configs
!examples/*config.json

# API Keys and Secrets
*api-key*
*secret*
*token*
*credentials*

# Generated MCP Configurations (may contain real API keys)
generated-*
local-*

# Claude Code Local Settings (may contain API keys)
.claude/
settings.local.json

# Backup Files
*.backup
*.bak

# Logs (may contain sensitive information)
*.log
logs/

# Cache and Temporary Files
.cache/
.tmp/
temp/

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE Files
.vscode/
.idea/
*.swp
*.swo

# Node.js (in case of local testing)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Personal Notes
notes.md
